---
import type { ImageMetadata } from "astro";
import { Image } from "astro:assets";
import "../stage-tokens.css";
import "./StagePhoto.css";

interface Props {
  src: ImageMetadata;
  alt: string;
  widths: number[];
  sizes: string;
  priority?: boolean;
  class?: string;
}

const {
  src,
  alt,
  widths,
  sizes,
  priority = false,
  class: className,
} = Astro.props;
---

<Image
  class={["stage-photo", className].filter(Boolean).join(" ")}
  src={src}
  alt={alt}
  widths={widths}
  sizes={sizes}
  loading={priority ? "eager" : "lazy"}
  fetchpriority={priority ? "high" : undefined}
/>
