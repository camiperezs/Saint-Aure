---
import Eyebrow from "../Eyebrow/Eyebrow.astro";
import MotionPause from "../MotionPause/MotionPause.astro";
import StageButton from "../StageButton/StageButton.astro";
import StageDust from "../StageDust/StageDust.astro";
import StageOrbit from "../StageOrbit/StageOrbit.astro";
import StagePhoto from "../StagePhoto/StagePhoto.astro";
import StageTitle from "../StageTitle/StageTitle.astro";
import type { HeroStageContent } from "../hero-stage";
import "../stage-tokens.css";
import "./HeroStage.css";

interface Props {
  content: HeroStageContent;
}

const { content } = Astro.props;
const titleId = "hero-stage-title";
---

<section class="hero-stage" aria-labelledby={titleId} data-motion-scope>
  <div class="hero-stage__bg" aria-hidden="true">
    <div class="hero-stage__amb"></div>
    <div class="hero-stage__glow"></div>
    <div class="hero-stage__band"></div>
  </div>

  <div class="hero-stage__comp">
    <div class="hero-stage__stage">
      <StageOrbit />
      <StagePhoto
        class="hero-stage__photo"
        src={content.image.src}
        alt={content.image.alt}
        widths={[480, 800, 1132]}
        sizes="(min-width: 64rem) 45vw, 80vw"
        priority
      />
    </div>

    <div class="hero-stage__copy">
      <Eyebrow class="hero-stage__eyebrow">{content.eyebrow}</Eyebrow>
      <StageTitle
        class="hero-stage__title"
        id={titleId}
        lines={content.titleLines}
      />
      <p class="hero-stage__lead">{content.description}</p>
      <div class="hero-stage__actions">
        <StageButton action={content.primaryAction} variant="satin" />
        <StageButton action={content.secondaryAction} variant="underline" />
      </div>
    </div>
  </div>

  <StageDust class="hero-stage__dust" />
  <MotionPause class="hero-stage__pause" />
</section>
