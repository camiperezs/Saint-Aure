---
import "./HeroHairFlow.css";

interface Props {
  /** Amplitud del parallax con el cursor (el movimiento ambiental es igual). */
  intensity?: "subtle" | "normal";
}

const { intensity = "normal" } = Astro.props;

/**
 * Geometría fija: una curva principal larga y tres secundarias más finas.
 *
 * Cada trazo es "M" + un primer segmento "C" + segmentos "S". El comando S
 * refleja el punto de control anterior, así la tangente es continua en cada
 * unión (sin vértices ni picos). Las formas no se animan: lo que se mueve son
 * los contenedores (ver el CSS).
 *
 * - layer: profundidad del parallax (1 cerca, 3 lejos).
 * - sway: variante de movimiento ambiental (duración, desfase, sentido).
 */
const strokes = [
  {
    id: "main",
    layer: 1,
    sway: 1,
    d: "M360 -20 C300 120 160 200 190 360 S330 560 260 720 S170 860 215 940",
  },
  {
    id: "a",
    layer: 2,
    sway: 2,
    d: "M400 40 C350 170 270 230 285 360 S380 520 340 660",
  },
  {
    id: "b",
    layer: 3,
    sway: 3,
    d: "M300 -10 C260 90 215 150 235 250 S285 360 262 450",
  },
  {
    id: "c",
    layer: 2,
    sway: 4,
    d: "M395 420 C350 500 300 540 310 620 S330 760 285 860",
  },
];
---

<div
  class:list={["hero-hair", `hero-hair--${intensity}`]}
  data-hair-flow
  aria-hidden="true"
>
  <svg
    class="hero-hair__svg"
    viewBox="0 0 400 900"
    preserveAspectRatio="xMaxYMid meet"
    focusable="false"
  >
    <defs>
      <linearGradient id="hero-hair-gradient" x1="0" y1="0" x2="0" y2="1">
        <stop class="hero-hair__stop hero-hair__stop--a" offset="0"></stop>
        <stop class="hero-hair__stop hero-hair__stop--b" offset="0.5"></stop>
        <stop class="hero-hair__stop hero-hair__stop--c" offset="1"></stop>
      </linearGradient>
    </defs>
    {strokes.map((stroke) => (
      <g class="hero-hair__layer" data-layer={stroke.layer}>
        <g class={`hero-hair__sway hero-hair__sway--${stroke.sway}`}>
          <path
            class={`hero-hair__path hero-hair__path--${stroke.id}`}
            d={stroke.d}
            pathLength="1"
          />
        </g>
      </g>
    ))}
  </svg>
</div>

<script>
  import { initHairFlow } from "@/scripts/hair-flow";

  document
    .querySelectorAll<HTMLElement>("[data-hair-flow]")
    .forEach((flow) => initHairFlow(flow));
</script>
