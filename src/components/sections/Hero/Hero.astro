---
import type { Hero } from "@/types/hero";
import Actions from "@/components/ui/Actions/Actions.astro";
import BackgroundMedia from "@/components/ui/BackgroundMedia/BackgroundMedia.astro";
import Container from "@/components/ui/Container/Container.astro";
import Media from "@/components/ui/Media/Media.astro";
import { imageSizes } from "@/utils/image-sizes";
import "./Hero.css";

type Props = Hero;

const hero = Astro.props;
const { eyebrow, title, description, actions = [] } = hero;
// El título se divide en palabras para revelarlas de a una (solo CSS). La
// palabra destacada conserva su <em> y entra un poco después.
const titleParts =
  hero.variant === "split" &&
  hero.titleAccent &&
  title.includes(hero.titleAccent)
    ? title.split(hero.titleAccent)
    : null;
const toWords = (text: string) => text.split(/\s+/).filter(Boolean);
const titleWords = titleParts
  ? [
      ...toWords(titleParts[0]).map((text) => ({ text, accent: false })),
      {
        text: hero.variant === "split" ? (hero.titleAccent ?? "") : "",
        accent: true,
      },
      ...toWords(titleParts[1]).map((text) => ({ text, accent: false })),
    ]
  : toWords(title).map((text) => ({ text, accent: false }));
---

{hero.variant === "fullscreen" && (
  <section
    class:list={[
      "hero",
      "hero--fullscreen",
      "on-overlay",
      `hero--align-${hero.alignment ?? "left"}`,
    ]}
  >
    <BackgroundMedia
      image={hero.image}
      overlay={hero.overlay}
      focalPoint={hero.focalPoint}
      priority
    />
    <Container size="wide" class="hero__inner">
      <div class="hero__content">
        {eyebrow && <p class="hero__eyebrow">{eyebrow}</p>}
        <h1 class="hero__title text-reflow">{title}</h1>
        {description && <p class="hero__description">{description}</p>}
        <Actions actions={actions} class="hero__actions" />
      </div>
      {hero.editorial && <p class="hero__editorial">{hero.editorial}</p>}
    </Container>
  </section>
)}

{hero.variant === "compact" && (
  <section class="hero hero--compact">
    <Container size={hero.contentWidth ?? "standard"} class="hero__inner">
      <div class="hero__content">
        {eyebrow && <p class="hero__eyebrow">{eyebrow}</p>}
        <h1 class="hero__title text-reflow">{title}</h1>
        {description && <p class="hero__description">{description}</p>}
        <Actions actions={actions} class="hero__actions" />
      </div>
      {hero.image && (
        <Media
          image={hero.image}
          priority
          class="hero__image"
          sizes={imageSizes.content}
        />
      )}
    </Container>
  </section>
)}

{hero.variant === "split" && (
  <section
    class:list={[
      "hero",
      "hero--split",
      `hero--image-${hero.imagePosition ?? "right"}`,
      `hero--ratio-${hero.ratio ?? "balanced"}`,
    ]}
  >
    <Container size="wide" class="hero__inner">
      <div class="hero__content">
        {eyebrow && <p class="hero__eyebrow">{eyebrow}</p>}
        <h1 class="hero__title text-reflow">
          {titleWords.map((word) => (
            <>
              {word.accent ? (
                <em class="hero__word hero__title-accent">{word.text}</em>
              ) : (
                <span class="hero__word">{word.text}</span>
              )}{" "}
            </>
          ))}
        </h1>
        {description && <p class="hero__description">{description}</p>}
        <Actions actions={actions} class="hero__actions" />
      </div>
      <div class="hero__media">
        <Media
          image={hero.image}
          priority
          class="hero__image"
          sizes={imageSizes.half}
        />
      </div>
    </Container>
  </section>
)}
