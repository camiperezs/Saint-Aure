---
import type { Action } from "@/types/action";
import ActionButton from "@/components/ui/ActionButton/ActionButton.astro";

interface Props {
  actions: Action[];
  class?: string;
}

const { actions, class: className } = Astro.props;
---

{actions.length > 0 && (
  <div class:list={["cluster", className]}>
    {actions.map((action, index) => (
      <ActionButton
        action={action}
        variant={index === 0 ? "primary" : "outline"}
      />
    ))}
  </div>
)}
