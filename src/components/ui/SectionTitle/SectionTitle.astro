---
import "./SectionTitle.css";

interface Props {
  eyebrow?: string;
  title: string;
  titleAccent?: string;
  description?: string;
  id?: string;
  level?: 1 | 2 | 3;
  align?: "start" | "center";
  accent?: boolean;
  class?: string;
}

const {
  eyebrow,
  title,
  titleAccent,
  description,
  id,
  level = 2,
  align = "start",
  accent = false,
  class: className,
} = Astro.props;

const Heading = `h${level}` as const;

// Parte el título en tres tramos si la subcadena existe; si no, se ignora.
const accentAt = titleAccent ? title.indexOf(titleAccent) : -1;
const before = accentAt >= 0 ? title.slice(0, accentAt) : title;
const emphasis = accentAt >= 0 ? titleAccent : undefined;
const after =
  accentAt >= 0 && titleAccent
    ? title.slice(accentAt + titleAccent.length)
    : "";
---

<hgroup
  class:list={[
    "section-title",
    `section-title--${align}`,
    accent && "section-title--accent",
    className,
  ]}
>
  {eyebrow && <p class="section-title__eyebrow">{eyebrow}</p>}
  <Heading id={id} class="section-title__heading text-reflow">
    {before}
    {emphasis && <em class="section-title__em">{emphasis}</em>}
    {after}
  </Heading>
  {description && <p class="section-title__description">{description}</p>}
</hgroup>
