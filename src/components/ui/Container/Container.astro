---
interface Props {
  size?: "narrow" | "standard" | "wide";
  as?: "div" | "section" | "header" | "footer" | "main" | "article";
  class?: string;
}

const { size = "standard", as: Tag = "div", class: className } = Astro.props;
---

<Tag class:list={["container", `container--${size}`, className]}>
  <slot />
</Tag>
