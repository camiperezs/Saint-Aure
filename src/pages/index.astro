---
import BaseLayout from "@/layouts/BaseLayout.astro";
import HeroStage from "@/client/HeroStage/HeroStage.astro";
import PageSections from "@/components/sections/PageSections.astro";
import { site } from "@/config/site";
import { page } from "@/content/page";
import { getBusinessStructuredData } from "@/utils/structured-data";
---

<BaseLayout headerOverlay motion>
  <script
    slot="head"
    type="application/ld+json"
    is:inline
    set:html={getBusinessStructuredData(site)}
  />
  <HeroStage />
  <PageSections
    sections={page.sections}
    labels={site.labels}
    locale={site.locale}
  />
</BaseLayout>
